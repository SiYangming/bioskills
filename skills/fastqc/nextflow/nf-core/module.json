{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "fastqc_nextflow_nfcore.json",
  "title": "nf-core fastqc module inputs",
  "type": "object",
  "required": ["reads"],
  "properties": {
    "meta":  { "type": "object", "description": "sample metadata map" },
    "reads": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ],
      "description": "FASTQ file(s) to run FastQC on"
    }
  }
}
