# custom/isoseq — Snakemake 骨架模板
# ---------------------------------------------------------------------------
# 用法：将本模板复制到实际项目，并把 include 指向各原子模块技能的
#       snakemake/local/rule_*.smk（迁移自原 snakemake.smk/isoseq.smk）。
# 也可用 nf-core/isoseq 的 Snakemake 迁移方案直接引用 snakemake-wrappers。
# ---------------------------------------------------------------------------

configfile: "config/config.yaml"

# 各步骤规则来自原子模块技能（已迁移原 isoseq.smk 的规则）
include: "../../skills/pbccs/snakemake/local/rule_pbccs.smk"
include: "../../skills/lima/snakemake/local/rule_lima.smk"
include: "../../skills/isoseq3/snakemake/local/rule_isoseq3.smk"
include: "../../skills/bamtools/snakemake/local/rule_bamtools_convert.smk"
include: "../../skills/gstama/snakemake/local/rule_gstama_polyacleanup.smk"
include: "../../skills/gstama/snakemake/local/rule_gstama_collapse.smk"
include: "../../skills/gstama/snakemake/local/rule_gstama_filelist.smk"
include: "../../skills/gstama/snakemake/local/rule_gstama_merge.smk"
include: "../../skills/minimap2/snakemake/local/rule_minimap2_align.smk"
include: "../../skills/ultra/snakemake/local/rule_ultra.smk"

# 输出目录（与原流程一致，01..09 分阶段）
PBCCS_DIR       = config.get("pbccs_dir",  "results/01PBCCS")
LIMA_DIR        = config.get("lima_dir",   "results/02LIMA")
ISOSEQ_DIR      = config.get("isoseq_dir", "results/03ISOSEQ_REFINE")
BAMTOOLS_DIR    = config.get("bamtools_dir", "results/04BAMTOOLS_CONVERT")
GSTAMA_DIR      = config.get("gstama_dir", "results/05TAMA_POLYACLEANUP")
MINIMAP2_DIR    = config.get("minimap2_dir", "results/06_01MINIMAP2")
ULTRA_DIR       = config.get("ultra_dir", "results/06_02ULTRA")
GSTAMA_COLLAPSE_DIR = config.get("gstama_collapse_dir", "results/07TAMA_COLLAPSE")
GSTAMA_FILELIST_DIR = config.get("gstama_filelist_dir", "results/08TAMA_FILELIST")
GSTAMA_MERGE_DIR    = config.get("gstama_merge_dir", "results/09TAMA_MERGE")
LOG_DIR         = config.get("logs_dir", "results/logs")

# 样本表解析（简化版：支持 sample, seq_data, start_from）
import pandas as pd

_samples = pd.read_csv(config["samplesheet"], dtype={"sample": str}).set_index("sample", drop=False)
CCS_SAMPLES = list(_samples.index)

rule all:
    input:
        # 完整链路产物由各规则自行串联；此处只声明最终产物
        f"{GSTAMA_MERGE_DIR}/merged.bed",
        f"{GSTAMA_MERGE_DIR}/versions.yml"
    default_target: True
