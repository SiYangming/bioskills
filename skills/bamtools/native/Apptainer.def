# bamtools native Apptainer/Singularity 定义（apt 最小化版本）
#
# 底座：Debian 12 bookworm-slim（通过 Docker hub library/debian:bookworm-slim bootstrap）
# 安装：bamtools=2.5.2+dfsg-4（Debian bookworm stable）+ python3 运行驱动
# 清理：apt lists / docs / man / cache
#
# 构建：apptainer build bamtools.sif Apptainer.def
# 运行：apptainer run bamtools.sif convert --bam /data/in.bam --outdir /data

Bootstrap: docker
From: debian:bookworm-slim

%labels
    Maintainer bioskills
    Software bamtools
    Version 2.5.2-v1.0
    BamToolsAptVersion 2.5.2+dfsg-4
    org.bioskills.software bamtools
    impl native
    base_image debian:bookworm-slim
    pkg_route apt

%files
    # 在 bootstrap 阶段把宿主机技能目录内容准备到镜像内路径
    main.py /opt/skill/main.py
    meta.yaml /opt/skill/meta.yaml
    test/ /opt/skill/test/

%post
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

    set -eux

    apt-get update
    apt-get install -y --no-install-recommends \
        bamtools=2.5.2+dfsg-4 \
        python3-minimal \
        python3 \
        python3-yaml \
        ca-certificates \
        procps

    ln -sf /usr/bin/python3 /usr/bin/python

    # 强清理文档 / 手册 / locale / apt 缓存，保持 sif 尽量小
    rm -rf \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/locale/* \
        /var/cache/debconf/* \
        /var/lib/apt/lists/* \
        /tmp/* \
        /var/tmp/*

    # 版本断言：确保 build 环境未意外升级到 >2.5.2
    dpkg -l | awk '$2=="bamtools"{print $3}' | grep -Eq '^2\.5\.2'

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/skill
    export PATH=/opt/skill:$PATH
    export TMPDIR=/tmp

%runscript
    exec /usr/bin/python3 /opt/skill/main.py "$@"

%test
    # 非交互自检：确保驱动与 bamtools 二进制可运行
    set -eux
    bamtools --version | grep -i bamtools
    /usr/bin/python3 /opt/skill/main.py --list-commands
    /usr/bin/python3 /opt/skill/main.py --schema > /tmp/schema.json
    test -s /tmp/schema.json
    rm -f /tmp/schema.json

%help
    bamtools native Apptainer 镜像（apt 最小化）。
    bamtools: Debian bookworm stable 2.5.2+dfsg-4
    调用方式：apptainer run bamtools.sif <subcommand> [options]
    挂载卷示例：apptainer run -B $PWD:/data -H /data bamtools.sif convert --bam /data/in.bam --outdir /data
