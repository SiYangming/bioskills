# subworkflow/fastp_bwa_samtools Snakemake 骨架
# 复制到真实项目中改为 workflow/Snakefile 再使用。
SAMPLES = ["s001"]
rule all:
    input:
        expand("results/bam/{sample}.sorted.bam.bai", sample=SAMPLES),

rule fastp:
    input:
        r1="raw/{sample}_R1.fq.gz",
        r2="raw/{sample}_R2.fq.gz",
    output:
        r1_clean="results/fastp/{sample}_R1.clean.fq.gz",
        r2_clean="results/fastp/{sample}_R2.clean.fq.gz",
        html="results/fastp/{sample}_fastp.html",
    threads: 8
    resources: mem_mb=16384
    shell:
        """
        python ../../fastp/native/main.py run \
            -i {input.r1} -I {input.r2} \
            -o {output.r1_clean} -O {output.r2_clean} \
            -h {output.html} --threads {threads}
        """

rule bwa_mem2_align:
    input:
        r1="results/fastp/{sample}_R1.clean.fq.gz",
        r2="results/fastp/{sample}_R2.clean.fq.gz",
        ref="ref/ref.fa",
    output:
        bam="results/bam/{sample}.bam",
    threads: 8
    resources: mem_mb=32768
    shell:
        """
        python ../../bwa-mem2/native/main.py mem \
            -R "@RG\\tID:{wildcards.sample}\\tSM:{wildcards.sample}\\tLB:{wildcards.sample}" \
            {input.ref} {input.r1} {input.r2} --threads {threads} \
            | samtools view -O BAM -o {output.bam}
        """

rule samtools_sort_index:
    input: "results/bam/{sample}.bam"
    output:
        bam="results/bam/{sample}.sorted.bam",
        bai="results/bam/{sample}.sorted.bam.bai",
    threads: 4
    resources: mem_mb=16384
    shell:
        """
        python ../../samtools/native/main.py sort {input} -o {output.bam} --threads {threads}
        python ../../samtools/native/main.py index {output.bam}
        """
