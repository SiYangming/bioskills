# =============================================================================
# genetribe native Apptainer 定义文件（无官方镜像，apt 最小化兜底；Conda 不做默认引入）
#
# 与 native/Dockerfile 同路线（2026-09-07 核实官方渠道全无）：
#   bioconda genetribe 404 / quay.io/biocontainers 无 / depot.galaxyproject.org 无
#   → debian:bookworm-slim + apt --no-install-recommends（ncbi-blast+=2.12.0+ds-3 /
#     bedtools=2.30.0+dfsg-3 / python3-venv）+ pip 装 jcvi（PyPI 当前 1.6.7，官方推荐 v1.0.6）
#     + git clone 官方 tag v1.2.1 + 上游 ./install.sh；
#   无 depot 预构建 sif，只能本地构建（不能 apptainer pull 直拉）。
#
# 构建：apptainer build genetribe-1.2.1.sif native/Apptainer.def
# 运行：apptainer run -B $PWD:/data -H /data genetribe-1.2.1.sif \
#         core -l aet -f rice --threads 16
# 注意：%runscript 直调 /opt/genetribe/genetribe（勿符号链接——上游按 argv[0] 相对路径找 bin/）
# =============================================================================
Bootstrap: docker
From: debian:bookworm-slim

%labels
    org.bioskills.software genetribe
    org.bioskills.impl native
    org.bioskills.base_image debian:bookworm-slim
    org.bioskills.genetribe_version 1.2.1
    org.bioskills.pkg_route "apt(ncbi-blast+/bedtools/python3-venv) + pip(jcvi) + git clone v1.2.1 + ./install.sh"

%environment
    export GENETRIBE_VERSION=1.2.1
    export PATH=/opt/genetribe:/opt/genetribe-venv/bin:${PATH}
    export TMPDIR=/tmp

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends \
        ca-certificates curl git gawk \
        ncbi-blast+ bedtools \
        python3 python3-venv python3-pip
    # jcvi(MCscan)：python3-venv 隔离安装（Debian PEP668 下系统 pip 不可直接写）
    python3 -m venv /opt/genetribe-venv
    /opt/genetribe-venv/bin/pip install --no-cache-dir 'jcvi>=1.0.6'
    # 官方源码：clone tag v1.2.1 + 上游 ./install.sh（生成 bin/ 符号链接）
    git clone --depth 1 --branch v1.2.1 https://github.com/chenym1/genetribe.git /opt/genetribe
    cd /opt/genetribe
    ./install.sh
    test -x /opt/genetribe/genetribe
    # 清理四连（仅构建期 git/curl/python3-pip 一并移除）
    apt-get purge -y curl git python3-pip
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info /tmp/* /var/tmp/*

%runscript
    exec /opt/genetribe/genetribe "$@"

%test
    out="$(/opt/genetribe/genetribe -h 2>&1 || true)"
    echo "$out" | grep -q "GeneTribe"
    echo "$out" | grep -q "1.2.1"
    echo "$out" | grep -q "sameassembly"
    command -v blastp >/dev/null && blastp -version | head -n 1
    command -v bedtools >/dev/null && bedtools --version
    python3 -c "import jcvi; print('jcvi import OK')"
