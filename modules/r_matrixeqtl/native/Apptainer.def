# r_matrixeqtl 自建容器（native/Apptainer.def）
#
# 与 native/Dockerfile 同构（rocker/r-ver:4.5.2 + MatrixEQTL），
# %test 用 Rscript 断言 MatrixEQTL 包可加载。运行产物归属由宿主 -B 挂载决定。
#
# 构建：
#   apptainer build r-matrixeqtl.sif Apptainer.def
# 运行（等价能力由 native/main.py analyze 子命令提供）：
#   apptainer run -B $PWD:/data -H /data r-matrixeqtl.sif \
#       Rscript /opt/skill/run_matrixeqtl.R /data/params.tsv

Bootstrap: docker
From: rocker/r-ver:4.5.2

%files
    run_matrixeqtl.R /opt/skill/run_matrixeqtl.R

%post
    R -e "install.packages('MatrixEQTL', repos='https://cloud.r-project.org', quiet=TRUE)"
    Rscript -e 'stopifnot(requireNamespace("MatrixEQTL", quietly=TRUE))'
    rm -rf /usr/local/lib/R/doc/html /tmp/* /var/tmp/*

%environment
    export TMPDIR=/tmp

%runscript
    exec Rscript "$@"

%test
    Rscript -e 'suppressPackageStartupMessages(library(MatrixEQTL)); cat(as.character(packageVersion("MatrixEQTL")), "\n")'

%labels
    Author bioskills
    org.bioskills.software r_matrixeqtl
    impl native
    base_image rocker/r-ver:4.5.2
    r_matrixeqtl_version 2.3
    pkg_route rocker R 底座 + CRAN 直装（官方 biocontainer 仅 2.1.1/R3.3，故自建）
