# =============================================================================
# Apptainer.def — sspace (SSPACE STANDARD v3.0) 自建兜底镜像
#
# 无官方渠道（bioconda sspace 404 / quay 无 / depot 无）→ debian 最小化兜底，
# 与 native/Dockerfile 同 apt 路线（apt --no-install-recommends + 清理四连），
# 不引入 micromamba。关键依赖 libperl4-corelibs-perl（getopts.pl）。
# 软件本体：官方发行 tar（BaseClear 原 URL 已 404，取自社区归档并校验 sha256）。
# =============================================================================
Bootstrap: docker
From: debian:bookworm-slim

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends \
        perl \
        libperl4-corelibs-perl \
        ca-certificates \
        curl \
        procps
    curl -fsSL -o /tmp/sspace.tar.gz \
        "https://raw.githubusercontent.com/yexianingyue/SSPACE-STANDARD-3.0/main/SSPACE-STANDARD-v.-3.0-linux-x86_64.tar.gz"
    echo "4a5064103921e196ad66f80c7ff4373ddc6be9d830b8f30b8cd5c6785693645a  /tmp/sspace.tar.gz" | sha256sum -c -
    mkdir -p /opt/sspace
    tar -xzf /tmp/sspace.tar.gz -C /opt/sspace
    printf '#!/bin/sh\nexec perl /opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64/SSPACE_Standard_v3.0.pl "$@"\n' > /usr/local/bin/SSPACE_Standard_v3.0.pl
    chmod +x /usr/local/bin/SSPACE_Standard_v3.0.pl
    printf '#!/bin/sh\nexec perl /opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64/tools/sam_bam2tab.pl "$@"\n' > /usr/local/bin/sam_bam2tab.pl
    chmod +x /usr/local/bin/sam_bam2tab.pl
    apt-get purge -y curl
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

%environment
    export TMPDIR=/tmp
    export PATH="/opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64:/usr/local/bin:$PATH"

%runscript
    exec /usr/local/bin/SSPACE_Standard_v3.0.pl "$@"

%test
    test -x /usr/local/bin/SSPACE_Standard_v3.0.pl
    grep -q 'SSPACE_Standard_v3.0_linux' /opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64/SSPACE_Standard_v3.0.pl
    perl -c /opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64/SSPACE_Standard_v3.0.pl
    test -x /opt/sspace/SSPACE-STANDARD-3.0_linux-x86_64/bowtie/bowtie
    echo "SSPACE-Standard v3.0 smoke OK"

%labels
    org.bioskills.software sspace
    org.bioskills.impl native
    org.bioskills.base_image debian:bookworm-slim
    sspace_version 3.0
    pkg_route "apt(perl+libperl4-corelibs-perl) + 官方发行 tar（社区归档 github.com/yexianingyue/SSPACE-STANDARD-3.0）"
