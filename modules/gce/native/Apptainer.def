# gce native Apptainer/Singularity 定义（bookworm-slim + 官方 tarball 源码 make 路线）
#
# 路线：与 Dockerfile 一致 —— GCE 1.0.0 无官方 conda/容器渠道（bioconda/quay/depot
#       2026-09 核实全无），官方 FTP 已停服；apt 装最小构建/运行依赖，下载 tarball
#       （首选 SiYangming/GCE release，回落 nottwy 社区镜像）后 make 重编译 gce，
#       并布署随包的 2012 年 kmerfreq 预编译二进制。
#
# 构建：apptainer build gce.sif Apptainer.def
# 运行：apptainer run gce.sif -f out.freq.stat -g 273206457 -m 1 -D 8 -b 1
# 说明：native/main.py 驱动在宿主机运行，不随镜像分发（镜像内仅 gce/kmer_freq_hash 二进制）。

Bootstrap: docker
From: debian:bookworm-slim

%labels
    Maintainer bioskills
    Software gce
    Version 1.0.0
    GceVersion 1.0.0
    PkgRoute apt(build+runtime) + official tarball source (make) + bundled 2012 kmerfreq binaries

%post
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TMPDIR=/tmp

    set -eux

    # 1) apt 最小依赖（curl 仅构建用，稍后删除）
    apt-get update
    apt-get install -y --no-install-recommends \
        build-essential \
        g++ \
        make \
        ca-certificates \
        curl \
        python3 \
        python3-yaml \
        procps
    ln -sf /usr/bin/python3 /usr/bin/python

    # 2) 官方 tarball 下载 + sha256 + 源码编译 gce + 布署 kmerfreq 二进制
    #    首选 SiYangming/GCE 版本化 release，失败回落 nottwy 社区镜像（同一 tarball）
    curl -fSL -o /tmp/gce.tar.gz \
        "https://github.com/SiYangming/GCE/releases/download/gce-1.0.0/gce-1.0.0.tar.gz" \
      || curl -fSL -o /tmp/gce.tar.gz \
        "https://github.com/nottwy/genome-character-estimator/raw/master/gce-1.0.0.tar.gz"
    echo "0eb4f2d3247527d9881e5ab993a12e9800a0b465d8acb4451ede951b2bdf99e1  /tmp/gce.tar.gz" | sha256sum -c -
    mkdir -p /tmp/src
    tar -xzf /tmp/gce.tar.gz -C /tmp/src
    SRC="$(find /tmp/src -mindepth 1 -maxdepth 1 -type d -name 'gce-*' | head -1)"
    cd "$SRC"
    make
    install -m 0755 ./gce /usr/local/bin/gce
    install -m 0755 ./kmerfreq/kmer_freq_hash/kmer_freq_hash /usr/local/bin/kmer_freq_hash
    for b in kmer_freq kmer_freq_pfile kmer_freq_pread; do
        install -m 0755 "./kmerfreq/kmer_freq_array/$b" "/usr/local/bin/$b"
    done

    # 3) 清理四连 + 删构建期 curl
    apt-get autoremove -y
    apt-get clean
    rm -rf \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/locale/* \
        /var/cache/debconf/* \
        /var/lib/apt/lists/* \
        /tmp/* \
        /var/tmp/*
    rm -f /usr/bin/curl

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TMPDIR=/tmp
    export PATH=/usr/local/bin:$PATH

%runscript
    exec gce "$@"

%test
    # 非交互自检：gce -h 打印 Version: 1.0.0（GCE 无 --version 旗标）
    set -eux
    command -v gce
    command -v kmer_freq_hash
    gce -h 2>&1 | grep -q "Version:"
    gce -h 2>&1 | grep -q "1.0.0"

%help
    gce native Apptainer 镜像（bookworm-slim + 官方 tarball 源码 make）。
    GCE 1.0.0：gce（基因组特征估计）/ kmer_freq_hash（k-mer 频数统计），位于 /usr/local/bin。
    调用方式：apptainer run gce.sif <gce 选项>（如 -f out.freq.stat -g 273206457 -m 1 -D 8 -b 1）
    挂载示例：apptainer run -B $PWD:/data -H /data gce.sif -f /data/out.freq.stat -g 273206457
    注：kmer_freq_hash 需 --entrypoint 或 exec 方式单独调用；软件已停更，新项目建议 GenomeScope 2.0。
