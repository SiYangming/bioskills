# =============================================================================
# Apptainer.def — fgenesh（自建兜底配方；许可受限）
#
# ⚠️ 许可受限：FGENESH 为 Softberry 商业软件，须向 Softberry 申请学术/商业许可后取得发行包，
#    禁止再分发。本配方**不下载**任何 Softberry 资产，改为在构建目录提供你已合法取得的
#    发行包 `fgenesh.tar.gz`（%files 从当前目录拾取）。
#
# 归属   ：bioskills modules/fgenesh/native/Apptainer.def
# 理由   ：官方渠道全无（bioconda/quay/depot 均无，2026-09 核实）+ 许可受限 → 自建 apt 最小化配方
# 路线   ：Bootstrap docker + debian:bookworm-slim，%post 内 apt 最小化 + 部署授权发行包
# 构建   ：将授权发行包放到本目录为 fgenesh.tar.gz，再：
#               apptainer build fgenesh.sif modules/fgenesh/native/Apptainer.def
# 运行   ：apptainer run -B $PWD:/data fgenesh.sif /data/genome.fasta -L /opt/fgenesh/params/fungi.par -o /data/out -gff -cpu 8
# =============================================================================
Bootstrap: docker
From: debian:bookworm-slim

%files
    # 构建上下文需提供 Softberry 授权发行包（用户自备；本镜像不内嵌、不下载）
    fgenesh.tar.gz /tmp/fgenesh.tar.gz

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends ca-certificates libc6 libstdc++6 procps
    mkdir -p /opt/fgenesh
    tar -xzf /tmp/fgenesh.tar.gz -C /opt/fgenesh
    bin="$(find /opt/fgenesh -maxdepth 4 -type f -name fgenesh | head -1)"
    test -n "$bin"
    chmod 0755 "$bin"
    ln -sf "$bin" /usr/local/bin/fgenesh
    # 清理四连
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

%environment
    export TMPDIR=/tmp
    export PATH=/usr/local/bin:$PATH

%runscript
    exec /usr/local/bin/fgenesh "$@"

%test
    # FGENESH 运行时可能需授权环境；此处仅验证二进制就位且可执行
    fgenesh 2>&1 | grep -qiE "fgenesh|usage|parameter" || true
    command -v fgenesh >/dev/null
    echo "fgenesh (Softberry licensed build) OK"

%labels
    org.bioskills.software fgenesh
    org.bioskills.impl fgenesh_native
    org.bioskills.base_image debian:bookworm-slim
    org.bioskills.fgenesh_version Softberry-licensed（版本以授权交付为准）
    org.bioskills.pkg_route apt(runtime) + 用户自备 Softberry 授权发行包（禁止再分发）
