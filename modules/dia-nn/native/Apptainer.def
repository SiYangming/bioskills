# =============================================================================
# dia-nn native Apptainer 定义文件（无官方镜像，apt 最小化兜底；Conda 不做默认引入）
#
# 与 native/Dockerfile 同路线（2026-09-07 核实官方渠道全无）：
#   bioconda dia-nn 404 / quay.io/biocontainers 无 / depot.galaxyproject.org 无
#   → debian:bookworm-slim + apt --no-install-recommends +
#     dotnet-runtime-8.0（packages.microsoft.com，非 SDK）+ 官方 Academia Linux zip；
#     无 depot 预构建 sif，只能本地构建（不能 apptainer pull 直拉）。
#
# 构建：apptainer build dia-nn-2.6.1.sif native/Apptainer.def
# 运行：apptainer run -B $PWD:/data -H /data dia-nn-2.6.1.sif \
#         diann --fasta ... --dir ... --out ... --threads N
# =============================================================================
Bootstrap: docker
From: debian:bookworm-slim

%labels
    org.bioskills.software dia-nn
    org.bioskills.impl native
    org.bioskills.base_image debian:bookworm-slim
    org.bioskills.diann_version 2.6.1
    org.bioskills.pkg_route "apt + dotnet-runtime-8.0(packages.microsoft.com) + 官方 zip(DIA-NN-2.6.1-Academia-Linux)"

%environment
    export DIANN_HOME=/opt/DIA-NN-2.6.1-Academia-Linux/diann-2.6.1
    export LD_LIBRARY_PATH="${DIANN_HOME}${LD_LIBRARY_PATH:+:${LD_LIBRARY_PATH}}"
    export DOTNET_CLI_TELEMETRY_OPTOUT=1
    export DOTNET_NOLOGO=1
    export TMPDIR=/tmp

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install -y --no-install-recommends ca-certificates wget unzip libgomp1
    wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O /tmp/packages-microsoft-prod.deb
    dpkg -i /tmp/packages-microsoft-prod.deb
    rm -f /tmp/packages-microsoft-prod.deb
    apt-get update
    apt-get install -y --no-install-recommends dotnet-runtime-8.0
    wget -q https://github.com/vdemichev/DiaNN/releases/download/2.0/DIA-NN-2.6.1-Academia-Linux.zip -O /tmp/diann.zip
    echo "f98e396af791f1903168b365a83fc2cc72208cc133281b9ce6ebe3a794b999ba  /tmp/diann.zip" | sha256sum -c -
    unzip -q /tmp/diann.zip -d /opt
    rm -f /tmp/diann.zip
    DIANN_HOME=/opt/DIA-NN-2.6.1-Academia-Linux/diann-2.6.1
    test -x "${DIANN_HOME}/diann-linux"
    chmod -R a+rX "${DIANN_HOME}"
    printf '#!/bin/sh\nLD_LIBRARY_PATH=%s${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\nexport LD_LIBRARY_PATH\nexec "%s/diann-linux" "$@"\n' "${DIANN_HOME}" "${DIANN_HOME}" > /usr/local/bin/diann
    chmod 0755 /usr/local/bin/diann
    apt-get purge -y wget unzip
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /usr/share/doc /usr/share/man /usr/share/info /tmp/* /var/tmp/*

%runscript
    exec diann "$@"

%test
    out="$(diann --help 2>&1 || true)"
    echo "$out" | head -n 3
    echo "$out" | grep -q "DIA-NN"
    echo "$out" | grep -q "2.6.1"
