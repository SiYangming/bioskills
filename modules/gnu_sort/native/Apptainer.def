# ---------------------------------------------------------------------------
# bioskills / gnu_sort native Apptainer/Singularity 定义
# Route: Debian bookworm-slim + apt（APT 路线）
#   安装 coreutils=9.1-1（Debian bookworm stable，提供 sort）+ python3 运行驱动。
# 目标：无 miniconda、仅保留运行必需、apt 立即清理。
# 运行时要求：apptainer run 自动继承宿主机 UID，避免文件属主污染。
#
# 构建：apptainer build gnu-sort.sif Apptainer.def
# 运行：apptainer run gnu-sort.sif sort /data/genes.gtf --args "-k1,1 -k4,4n"
# ---------------------------------------------------------------------------

Bootstrap: docker
From: debian:bookworm-slim

%labels
    Maintainer bioskills
    Software gnu_sort
    Version 9.1-v1.0
    CoreutilsAptVersion 9.1-1
    PkgRoute apt (Debian bookworm stable)

%files
    # 在 bootstrap 阶段把宿主机技能目录内容准备到镜像内路径
    main.py /opt/skill/main.py
    meta.yaml /opt/skill/meta.yaml
    test/ /opt/skill/test/

%post
    export DEBIAN_FRONTEND=noninteractive
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8

    set -eux

    apt-get update
    apt-get install -y --no-install-recommends \
        coreutils=9.1-1 \
        python3-minimal \
        python3 \
        python3-yaml \
        ca-certificates \
        procps

    ln -sf /usr/bin/python3 /usr/bin/python

    # 强清理文档 / 手册 / locale / apt 缓存（清理四连），保持 sif 尽量小
    apt-get autoremove -y
    apt-get clean
    rm -rf \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/locale/* \
        /var/cache/debconf/* \
        /var/lib/apt/lists/* \
        /tmp/* \
        /var/tmp/*

    # 版本断言：确保 build 环境未意外升级到 >9.1
    dpkg -l | awk '$2=="coreutils"{print $3}' | grep -Eq '^9\.1(-|$)'

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/opt/skill
    export PATH=/opt/skill:$PATH
    export TMPDIR=/tmp

%runscript
    exec /usr/bin/python3 /opt/skill/main.py "$@"

%test
    # 非交互自检：确保驱动与 sort 二进制可运行
    set -eux
    sort --version | grep -E "coreutils|Apple" | head -n1
    /usr/bin/python3 /opt/skill/main.py --list-commands
    /usr/bin/python3 /opt/skill/main.py --schema > /tmp/schema.json
    test -s /tmp/schema.json
    rm -f /tmp/schema.json

%help
    gnu_sort native Apptainer 镜像（apt 最小化）。
    coreutils: Debian bookworm stable 9.1-1（binary: sort）
    调用方式：apptainer run gnu-sort.sif sort <in> [--args "<sort 参数>"] [-o <out>]
    挂载卷示例：apptainer run -B $PWD:/data -H /data gnu-sort.sif sort /data/genes.gtf --args "-k1,1 -k4,4n" -o /data/genes.sorted.gtf
