# =============================================================================
# ANNOVAR Apptainer 定义（官方渠道无 ANNOVAR 镜像 → 兜底配方）
#
# 路线：apt 最小化优先（debian:bookworm-slim + apt --no-install-recommends + 清理四连）。
#   ANNOVAR 无 conda 包（bioconda 404）/ 无 quay / 无 depot，故不引入 conda 兜底。
#
# ⚠️ 构建前请先在官网注册下载 annovar.latest.tar.gz（许可受限），并放到本目录：
#      https://www.openbioinformatics.org/annovar/annovar_download_form.php
#    构建：apptainer build annovar.sif modules/annovar/native/Apptainer.def
#    运行：apptainer run annovar.sif <table_annovar.pl 参数...>
#
# 说明：ANNOVAR 无稳定 `--version`（版本以 annovar.latest.tar.gz 发布期命名），
#      故 %test 断言核心脚本存在且可被 perl 加载，而非比对固定版本号。
# =============================================================================
Bootstrap: docker
From: debian:bookworm-slim

%files
    annovar.latest.tar.gz /tmp/annovar.tar.gz

%post
    export DEBIAN_FRONTEND=noninteractive
    apt-get update -y
    apt-get install -y --no-install-recommends \
        perl \
        libwww-perl \
        ca-certificates \
        procps
    mkdir -p /opt/annovar
    tar -xzf /tmp/annovar.tar.gz -C /opt/annovar --strip-components=1
    rm -f /tmp/annovar.tar.gz
    chmod +x /opt/annovar/*.pl
    test -f /opt/annovar/table_annovar.pl
    test -f /opt/annovar/annotate_variation.pl
    # 清理四连
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

%environment
    export ANNOVAR_HOME=/opt/annovar
    export PATH=/opt/annovar:$PATH
    export TMPDIR=/tmp

%runscript
    exec perl /opt/annovar/table_annovar.pl "$@"

%test
    set -e
    test -f /opt/annovar/table_annovar.pl
    test -f /opt/annovar/annotate_variation.pl
    perl /opt/annovar/table_annovar.pl --help > /dev/null 2>&1 || true
    echo "ANNOVAR package present (version: latest, registration-gated)"

%labels
    org.bioskills.software annovar
    org.bioskills.impl annovar_native
    org.bioskills.base_image debian:bookworm-slim
    org.bioskills.annovar_version latest
    org.bioskills.pkg_route apt+user-tarball
