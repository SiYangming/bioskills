# signalp native Apptainer/Singularity 配方（自建兜底：与 native/Dockerfile 同一 apt 路线）
# ---------------------------------------------------------------------------
# 路线说明：SignalP 无官方 conda/容器（bioconda→quay→depot 全无，2026-09 核实），
# Debian bookworm 亦无该包；且官方 tarball 许可受限（需 edu 邮箱向 DTU 申请）。
# 故走自建兜底：debian:bookworm-slim + apt perl 运行时 + 用户自备授权 tarball。
#
# ⚠️ 构建前请二选一：
#   1) 环境变量提供自托管/本地授权包地址：
#        export SIGNALP_URL=https://<your-mirror>/signalp-5.0.Linux.tar.gz
#        apptainer build signalp.sif Apptainer.def
#   2) 或将授权 tarball 放到本目录并解开下面 %files 中的注释。
# 官方申请入口：https://services.healthtech.dtu.dk/services/software.php
# ---------------------------------------------------------------------------
Bootstrap: docker
From: debian:bookworm-slim

%files
    # 如已持有官方授权 signalp-5.0.Linux.tar.gz，可去掉下一行注释并放到本目录
    # signalp-5.0.Linux.tar.gz /tmp/signalp.tar.gz

%post
    set -eux
    export DEBIAN_FRONTEND=noninteractive
    SIGNALP_URL="${SIGNALP_URL:-}"

    apt-get update
    apt-get install -y --no-install-recommends \
        perl \
        ca-certificates \
        procps \
        curl

    mkdir -p /opt/signalp
    if [ -f /tmp/signalp.tar.gz ]; then
        tar -xzf /tmp/signalp.tar.gz -C /opt/signalp --strip-components=1
    else
        test -n "${SIGNALP_URL}" || { \
            echo "需提供 SIGNALP_URL 或 %files 本地授权 tarball（官方需 edu 邮箱申请）" >&2; exit 1; }
        curl -fL "${SIGNALP_URL}" -o /tmp/signalp.tar.gz
        tar -xzf /tmp/signalp.tar.gz -C /opt/signalp --strip-components=1
    fi
    test -x /opt/signalp/bin/signalp

    # 清理四连 + 删构建期 curl
    apt-get purge -y curl
    apt-get autoremove -y
    apt-get clean
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/* /tmp/signalp.tar.gz
    rm -f /usr/bin/curl

%environment
    export LANG=C.UTF-8
    export LC_ALL=C.UTF-8
    export TMPDIR=/tmp
    export PATH=/opt/signalp/bin:$PATH

%runscript
    exec /opt/signalp/bin/signalp "$@"

%test
    set -eux
    test -x /opt/signalp/bin/signalp
    /opt/signalp/bin/signalp -version

%labels
    org.bioskills.software signalp
    org.bioskills.impl signalp_native
    org.bioskills.base_image debian:bookworm-slim
    org.bioskills.signalp_version 5.0
    org.bioskills.pkg_route apt(perl) + user-provided licensed signalp tarball -> /opt/signalp

%help
    signalp native Apptainer 镜像（自建兜底，许可受限需自备官方授权 tarball）。
    调用方式：apptainer run signalp.sif -org euk -fasta /data/proteins.fasta -gff3 -mature
